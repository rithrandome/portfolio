# Copy this file to .env.local for local development, and add the same variables
# in Vercel under Project → Settings → Environment Variables for production.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form messages are delivered. Without a verified domain in Resend,
# this must be the email address you signed up to Resend with.
CONTACT_TO_EMAIL=

# Optional. Leave unset to use Resend's shared sender (onboarding@resend.dev).
# Set it once you've verified your own domain in Resend, e.g. "Rithwik <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
